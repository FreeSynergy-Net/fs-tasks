    "text": { "$type": "color", "$value": "#1f2933" },
    "text-muted": { "$type": "color", "$value": "#616e7c" },
    "accent": { "$type": "color", "$value": "#2563eb" },
    "warning": { "$type": "color", "$value": "#b45309" },
    "danger": { "$type": "color", "$value": "#b91c1c" },
    "done": { "$type": "color", "$value": "#15803d" }
  },
  "space": {
    "gap": { "$type": "dimension", "$value": "12px" },
    "card-inset": { "$type": "dimension", "$value": "10px" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "6px" },
    "chip": { "$type": "dimension", "$value": "999px" }
  },
  "font": {
