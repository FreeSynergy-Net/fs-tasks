{
  "$description": "Style layer of the fs-tasks frontend board-wip (ADR 0074, DTCG). Placeholder values, NOT measured from any model picture. The form file only names the style (style = \"board-wip\").",
  "$license": "Own values; no source picture used. Reference: none.",
  "color": {
