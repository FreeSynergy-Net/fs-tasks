{
  "$description": "Style layer 'plain' (ADR 0074, DTCG tokens). Tokens only, no code. Light scheme first; dark scheme follows as its own step. Look taken from a plain board in our own words; no colour, picture or text of the model program is copied (ADR 0013).",
  "board": {
    "column": {
      "border-width": { "$type": "dimension", "$value": "0px" },
      "border-color": { "$type": "color", "$value": "#00000000" },
      "background": { "$type": "color", "$value": "#00000000" },
      "gap": { "$type": "dimension", "$value": "16px" },
      "head-text": { "$type": "color", "$value": "#374151" },
      "head-weight": { "$type": "fontWeight", "$value": 600 }
    },
    "card": {
      "background": { "$type": "color", "$value": "#ffffff" },
      "border-width": { "$type": "dimension", "$value": "1px" },
      "border-color": { "$type": "color", "$value": "#e5e7eb" },
      "radius": { "$type": "dimension", "$value": "6px" },
      "padding": { "$type": "dimension", "$value": "10px" },
      "title-text": { "$type": "color", "$value": "#111827" },
      "due-text": { "$type": "color", "$value": "#6b7280" }
    }
  }
}
